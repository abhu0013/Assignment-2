{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "title": "Historical Attendance at Major Pokémon TCG Events",
  "projection": {
    "type": "equirectangular",
    "rotate": [-140, 0, 0]
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "#e0e0e0", "stroke": "white", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "Source 2/pokemon_championships.csv"
      },
      "mark": {"type": "circle", "opacity": 0.8, "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "attendance",
          "type": "quantitative",
          "scale": {"range": [20, 1000]},
          "title": "Total Attendance"
        },
        "color": {
          "field": "tier",
          "type": "nominal",
          "scale": {
            "domain": ["World Championship", "International", "Regional"],
            "range": ["#e3350d", "#2a75bb", "#ffcb05"]
          },
          "title": "Tournament Tier"
        },
        "tooltip": [
          {"field": "tournament_name", "type": "nominal", "title": "Event"},
          {"field": "city", "type": "nominal", "title": "Location"},
          {"field": "attendance", "type": "quantitative", "format": ",", "title": "Players"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lat": -37.8136, 
            "lon": 144.9631, 
            "text_lat": -50, 
            "text_lon": 115, 
            "text": "Melbourne: Oceania's Premier Hub"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule", 
            "color": "#7f7f7f", 
            "strokeDash": [3, 3],
            "strokeWidth": 1.5
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "longitude2": {"field": "text_lon"},
            "latitude2": {"field": "text_lat"}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "bottom",
            "dy": -5,
            "fontWeight": "bold",
            "fontSize": 12,
            "color": "#e3350d"
          },
          "encoding": {
            "longitude": {"field": "text_lon", "type": "quantitative"},
            "latitude": {"field": "text_lat", "type": "quantitative"},
            "text": {"field": "text", "type": "nominal"}
          }
        }
      ]
    }
  ]
}