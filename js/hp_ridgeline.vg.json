{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 120,
  "title": {
    "text": "HP Density Shift: Base (1999) vs Black & White (2011) vs Sword & Shield (2020)",
    "subtitle": ["Notice the massive 'fat tail' stretching past 300 HP in the modern Sword & Shield era,", "proving the game's average baseline has entirely shifted to the right."],
    "subtitleColor": "#e3350d",
    "subtitleFontStyle": "italic",
    "subtitlePadding": 10
  },
  "data": {
    "url": "Source 1/pokemon-tcg-data-master 1999-2023.csv"
  },
  "transform": [
    {"calculate": "toNumber(datum.hp)", "as": "numeric_hp"},
    {"filter": "datum.numeric_hp > 0 && datum.numeric_hp <= 400"},
    {"filter": "datum.supertype == 'Pokémon'"},
    {"filter": "datum.series == 'Base' || datum.series == 'Black & White' || datum.series == 'Sword & Shield'"},
    {
      "density": "numeric_hp",
      "groupby": ["series"],
      "extent": [10, 400],
      "steps": 200
    }
  ],
  "mark": {"type": "area", "opacity": 0.6, "interpolate": "monotone"},
  "encoding": {
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "Hit Points (HP)",
      "axis": {"grid": false}
    },
    "y": {
      "field": "density",
      "type": "quantitative",
      "title": "Density of Cards",
      "axis": null
    },
    "color": {
      "field": "series",
      "type": "nominal",
      "title": "Era",
      "scale": {
        "domain": ["Base", "Black & White", "Sword & Shield"],
        "range": ["#f0d900", "#5c5c5c", "#e3350d"]
      }
    },
    "row": {
      "field": "series",
      "type": "nominal",
      "title": null,
      "header": {"labelAngle": 0, "labelAlign": "left", "labelFontSize": 12, "labelFontWeight": "bold"}
    },
    "tooltip": [
      {"field": "series", "type": "nominal", "title": "Era"},
      {"field": "value", "type": "quantitative", "title": "HP Range (Approx)"}
    ]
  },
  "config": {
    "view": {"stroke": "transparent"},
    "concat": {"spacing": -10}
  }
}