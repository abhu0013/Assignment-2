{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "title": {
    "text": "HP Density Shift: Base (1999) vs Black & White (2011) vs Sword & Shield (2020)",
    "subtitle": ["Notice the massive 'fat tail' stretching past 300 HP in the modern Sword & Shield era,", "proving the game's average baseline has entirely shifted to the right."],
    "subtitleColor": "#e3350d",
    "subtitleFontStyle": "italic",
    "subtitlePadding": 10
  },
  "data": {
    "url": "Source 1/pokemon-tcg-data-master 1999-2023.csv"
  },
  "transform": [
    {"calculate": "toNumber(datum.hp)", "as": "numeric_hp"},
    {"filter": "datum.numeric_hp > 0 && datum.numeric_hp <= 400"},
    {"filter": "datum.supertype == 'Pokémon'"},
    {"filter": "datum.series == 'Base' || datum.series == 'Black & White' || datum.series == 'Sword & Shield'"},
    {
      "density": "numeric_hp",
      "groupby": ["series"],
      "extent": [10, 400],
      "steps": 200
    },
    {"filter": "datum.density > 0.001"}
  ],
  "layer": [
    {
      "mark": "area",
      "encoding": {
        "x": {"field": "value", "type": "quantitative", "title": "Hit Points (HP)"},
        "y": {"field": "density", "type": "quantitative", "axis": null},
        "color": {"field": "series", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 25,
        "opacity": 0
      },
      "encoding": {
        "x": {"field": "value", "type": "quantitative"},
        "y": {"field": "density", "type": "quantitative"},
        "color": {"field": "series", "type": "nominal"},
        "tooltip": [
          {"field": "series", "type": "nominal", "title": "Era"},
          {"field": "value", "type": "quantitative", "title": "HP Range (Approx)"}
        ]
      }
    }
  ],
  "config": {
    "title": {
      "fontSize": 14,
      "anchor": "middle"
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelLimit": 200
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "text": {
      "fontSize": 12
    },
    "view": {"stroke": "transparent"},
    "concat": {"spacing": -10}
  }
}