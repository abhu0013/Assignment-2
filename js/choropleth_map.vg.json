{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "title": "National Pokémon TCG Attendance Density",
  "projection": {
    "type": "equalEarth",
    "scale": 160,
    "center": [0, 20]
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "#e0e0e0", "stroke": "white", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "Source 2/pokemon_championships.csv"
      },
      "transform": [
        {
          "aggregate": [{"op": "sum", "field": "attendance", "as": "Total_Attendance"}],
          "groupby": ["country"]
        },
        {
          "joinaggregate": [
            {"op": "sum", "field": "Total_Attendance", "as": "Global_Attendance"}
          ]
        },
        {
          "calculate": "datum.Total_Attendance / datum.Global_Attendance",
          "as": "Attendance_Share"
        },
        {
          "lookup": "country",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
              "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "key": "properties.NAME",
            "fields": ["type", "geometry"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
      "encoding": {
        "shape": {"field": "geometry", "type": "geojson"},
        "color": {
      "field": "Attendance_Share",
      "type": "quantitative",
      "title": "Share of Global Attendance",
      "scale": {
        "type": "symlog",
        "scheme": "reds"
      },
      "legend": {
        "title": "Share of Global Attendance",
        "format": ".1%",
        "orient": "bottom",
        "direction": "horizontal",
        "titleLimit": 200,
        "gradientLength": 200
      }
    },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Country"},
          {"field": "Total_Attendance", "type": "quantitative", "title": "Total Attendance"},
          {"field": "Attendance_Share", "type": "quantitative", "title": "Global Share", "format": ".1%"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lat": -25.2744, 
            "lon": 133.7751, 
            "text_lat": -45, 
            "text_lon": 110, 
            "text": "High national participation in Australia"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule", 
            "color": "#7f7f7f", 
            "strokeDash": [3, 3],
            "strokeWidth": 1.5
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "longitude2": {"field": "text_lon"},
            "latitude2": {"field": "text_lat"}
          }
        },
        {
          "mark": {
            "type": "text",
            "fill": "#b30000",
            "fontStyle": "italic",
            "fontWeight": "bold",
            "stroke": "black",
            "strokeWidth": 0.7,
            "align": "center",
            "dx": -5,
            "dy": 8,
            "clip": false
          },
          "encoding": {
            "longitude": {"field": "text_lon", "type": "quantitative"},
            "latitude": {"field": "text_lat", "type": "quantitative"},
            "text": {"field": "text", "type": "nominal"}
          }
        }
      ]
    }
  ],
  "config": {
    "title": {
      "fontSize": 14,
      "anchor": "middle"
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelLimit": 200
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "text": {
      "fontSize": 12
    }
  }
}