{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 450,
  "title": "Cultural Import: The World Travels to Oceania",
  "projection": {
    "type": "equirectangular",
    "rotate": [-140, 0, 0]
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "#e0e0e0", "stroke": "white", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "Source 2/pokemon_championships.csv"
      },
      "transform": [
        {"filter": "datum.tier == 'International' || datum.tier == 'World Championship'"},
        {"filter": "datum.city != 'Melbourne'"},
        {"calculate": "-37.8136", "as": "melb_lat"},
        {"calculate": "144.9631", "as": "melb_lon"}
      ],
      "mark": {"type": "rule", "color": "#e3350d", "opacity": 0.4, "strokeWidth": 1.5},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "longitude2": {"field": "melb_lon"},
        "latitude2": {"field": "melb_lat"}
      }
    },
    {
      "data": {
        "url": "Source 2/pokemon_championships.csv"
      },
      "transform": [
        {"filter": "datum.tier == 'International' || datum.tier == 'World Championship'"}
      ],
      "mark": {"type": "circle", "opacity": 0.9, "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "attendance",
          "type": "quantitative",
          "scale": {"range": [30, 400]},
          "title": "Hub Attendance"
        },
        "color": {
          "field": "tier",
          "type": "nominal",
          "scale": {
            "domain": ["World Championship", "International"],
            "range": ["#e3350d", "#2a75bb"]
          },
          "title": "Tournament Tier"
        },
        "tooltip": [
          {"field": "city", "type": "nominal", "title": "Origin Hub"},
          {"field": "country", "type": "nominal", "title": "Country"},
          {"field": "tier", "type": "nominal", "title": "Tier"},
          {"field": "attendance", "type": "quantitative", "format": ",", "title": "Local Players"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lat": -37.8136, "lon": 144.9631, "city": "Melbourne (OCIC Destination)"}
        ]
      },
      "mark": {"type": "circle", "color": "#ffcb05", "size": 200, "stroke": "white", "strokeWidth": 1.5, "opacity": 1},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "tooltip": [{"field": "city", "type": "nominal", "title": "Hub"}]
      }
    },
    {
      "data": {
        "values": [
          {
            "lat": -37.8136,
            "lon": 144.9631,
            "text_lat": -28,
            "text_lon": 115,
            "text": "Melbourne OCIC draws global competitors"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#7f7f7f",
            "strokeDash": [3, 3],
            "strokeWidth": 1.5
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "longitude2": {"field": "text_lon"},
            "latitude2": {"field": "text_lat"}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "bottom",
            "dy": -5,
            "fontWeight": "bold",
            "fontSize": 12,
            "color": "#333"
          },
          "encoding": {
            "longitude": {"field": "text_lon", "type": "quantitative"},
            "latitude": {"field": "text_lat", "type": "quantitative"},
            "text": {"field": "text", "type": "nominal"}
          }
        }
      ]
    }
  ]
}