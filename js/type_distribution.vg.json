{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "title": "Historical Distribution of Pokémon Types (1999-2023)",
  "data": {
    "url": "Source 1/pokemon-tcg-data-master 1999-2023.csv"
  },
  "transform": [
    {"filter": "datum.supertype == 'Pokémon'"},
    {"filter": "datum.types != null"},
    {
      "calculate": "indexof(datum.types, 'Grass') > -1 ? 'Grass' : indexof(datum.types, 'Fire') > -1 ? 'Fire' : indexof(datum.types, 'Water') > -1 ? 'Water' : indexof(datum.types, 'Lightning') > -1 ? 'Lightning' : indexof(datum.types, 'Psychic') > -1 ? 'Psychic' : indexof(datum.types, 'Fighting') > -1 ? 'Fighting' : indexof(datum.types, 'Darkness') > -1 ? 'Darkness' : indexof(datum.types, 'Metal') > -1 ? 'Metal' : indexof(datum.types, 'Fairy') > -1 ? 'Fairy' : indexof(datum.types, 'Dragon') > -1 ? 'Dragon' : indexof(datum.types, 'Colorless') > -1 ? 'Colorless' : 'Other'",
      "as": "Clean_Type"
    },
    {"filter": "datum.Clean_Type != 'Other'"}
  ],
  "layer": [
    {
      "params": [
        {
          "name": "TypeSelection",
          "select": {"type": "point", "fields": ["Clean_Type"]},
          "bind": "legend"
        }
      ],
      "mark": {"type": "area", "opacity": 0.9},
      "encoding": {
        "x": {
          "field": "release_date",
          "type": "temporal",
          "timeUnit": "year",
          "title": "Release Year",
          "axis": {"domain": false, "tickSize": 0}
        },
        "y": {
          "aggregate": "count",
          "type": "quantitative",
          "stack": "normalize",
          "title": "Proportion of Cards Printed",
          "axis": {"format": "%"}
        },
        "color": {
          "field": "Clean_Type",
          "type": "nominal",
          "title": "Pokémon Type",
          "scale": {
            "domain": ["Grass", "Fire", "Water", "Lightning", "Psychic", "Fighting", "Darkness", "Metal", "Fairy", "Dragon", "Colorless"],
            "range": ["#78C850", "#F08030", "#6890F0", "#F8D030", "#F85888", "#C03028", "#705848", "#B8B8D0", "#EE99AC", "#7038F8", "#A8A878"]
          }
        },
        "opacity": {
          "condition": {"param": "TypeSelection", "value": 0.9},
          "value": 0.1
        },
        "tooltip": [
          {"field": "Clean_Type", "type": "nominal", "title": "Type"},
          {"field": "release_date", "type": "temporal", "timeUnit": "year", "title": "Year"},
          {"aggregate": "count", "type": "quantitative", "title": "Total Cards Printed"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2016-06-01", 
            "y": 0.96, 
            "text": "The short-lived Fairy Era (2014-2020)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontWeight": "bold",
        "fontSize": 12,
        "color": "#333",
        "dy": 15
      },
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    }
  ]
}