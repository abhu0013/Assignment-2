{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "title": "The Competitive Meta: Top 6 Elements Ranked by Series",
  "data": {"url": "Source 1/pokemon-tcg-data-master 1999-2023.csv"},
  "transform": [
    {"filter": "datum.supertype == 'Pokémon'"},
    {"filter": "datum.types != null"},
    {
      "filter": "datum.series != 'Other' && datum.series != 'POP' && datum.series != 'NP' && datum.series != 'E-Card'"
    },
    {"calculate": "toDate(datum.release_date)", "as": "date_obj"},
    {
      "calculate": "indexof(datum.types, 'Grass') > -1 ? 'Grass' : indexof(datum.types, 'Fire') > -1 ? 'Fire' : indexof(datum.types, 'Water') > -1 ? 'Water' : indexof(datum.types, 'Lightning') > -1 ? 'Lightning' : indexof(datum.types, 'Psychic') > -1 ? 'Psychic' : indexof(datum.types, 'Fighting') > -1 ? 'Fighting' : indexof(datum.types, 'Darkness') > -1 ? 'Darkness' : indexof(datum.types, 'Metal') > -1 ? 'Metal' : indexof(datum.types, 'Dragon') > -1 ? 'Dragon' : indexof(datum.types, 'Colorless') > -1 ? 'Colorless' : 'Other'",
      "as": "Clean_Type"
    },
    {"filter": "datum.Clean_Type != 'Other'"},
    {
      "aggregate": [
        {"op": "count", "as": "type_count"},
        {"op": "min", "field": "date_obj", "as": "era_sort"}
      ],
      "groupby": ["series", "Clean_Type"]
    },
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "type_count", "order": "descending"}],
      "groupby": ["series"]
    },
    {"filter": "datum.rank <= 6"}
  ],
  "encoding": {
    "x": {
      "field": "series",
      "type": "nominal",
      "title": "Card Series (Historical Timeline)",
      "sort": {"op": "min", "field": "era_sort", "order": "ascending"},
      "axis": {"labelAngle": -45, "grid": true}
    },
    "y": {
      "field": "rank",
      "type": "ordinal",
      "title": "Popularity Rank",
      "sort": "ascending",
      "axis": {"domain": false, "tickSize": 0}
    },
    "color": {
      "field": "Clean_Type",
      "type": "nominal",
      "title": "Pokémon Type",
      "scale": {
        "domain": [
          "Grass", "Fire", "Water", "Lightning", "Psychic", 
          "Fighting", "Darkness", "Metal", "Dragon", "Colorless"
        ],
        "range": [
          "#E69F00", "#56B4E9", "#009E73", "#F0E442", "#0072B2",
          "#D55E00", "#CC79A7", "#000000"
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 5,
        "opacity": 0.8
      }
    },
    {
      "mark": {"type": "circle", "size": 200, "opacity": 1},
      "encoding": {
        "tooltip": [
          {"field": "series", "type": "nominal", "title": "Expansion Era"},
          {"field": "Clean_Type", "type": "nominal", "title": "Pokémon Element"},
          {"field": "rank", "type": "quantitative", "title": "Popularity Rank"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "series": "Diamond & Pearl",
            "rank": 1,
            "text": "Psychic elements dominate the D&P and Platinum meta"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fill": "#b30000",
        "fontStyle": "italic",
        "fontWeight": "bold",
        "stroke": "black",
        "strokeWidth": 0.7,
        "align": "left",
        "dx": -35,
        "dy": -20,
        "clip": false
      },
      "encoding": {
        "x": {"field": "series"},
        "y": {"field": "rank"},
        "text": {"field": "text"},
        "color": {"value": "#F85888"}
      }
    }
  ],
  "config": {
    "title": {
      "fontSize": 14,
      "anchor": "middle"
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelLimit": 200
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "text": {
      "fontSize": 12
    }
  }
}
